<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext traffic for local development -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.30.201.225</domain>
        <domain includeSubdomains="true">10.49.123.225</domain>
        <domain includeSubdomains="true">10.173.95.225</domain>
        <domain includeSubdomains="true">10.113.156.225</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">10.11.219.225</domain>
    </domain-config>
</network-security-config>
